{
  "rewrites": [
    { "source": "/landings", "destination": "/api/landings" },
    { "source": "/search", "destination": "/api/search" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/landings.ts": {
      "includeFiles": "server/**"
    },
    "api/search.ts": {
      "includeFiles": "server/**"
    }
  }
}
