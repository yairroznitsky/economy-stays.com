{
  "rewrites": [
    { "source": "/api/sessions", "destination": "/api/landings" },
    { "source": "/api/exits", "destination": "/api/search" },
    { "source": "/s/:token", "destination": "/api/spider/:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
