# Supabase (client may still use anon for edge invoke when not proxied)
VITE_SUPABASE_URL=https://vbtmydsmqlkzfmbcmfxb.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only tracking (POST /api/landings, /api/search â†’ service role inserts)
SUPABASE_URL=https://vbtmydsmqlkzfmbcmfxb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: point browser at api.economy-stays.com (bare /landings + /search via vercel rewrites)
# VITE_TRACKING_API_BASE=https://api.economy-stays.com

# Site identity (defaults match Economy Stays)
VITE_SITE_NAME=Economy Stays
VITE_SITE_WORDMARK=Economy-Stays
VITE_SITE_SLUG=economy-stays
VITE_SITE_SHORT_NAME=EconomyStays
# Feed URLs always use www (see scripts/lib/feedSiteDomain.ts).
VITE_SITE_DOMAIN=economy-stays.com
VITE_SITE_OPERATOR=Benzerweb LTD
VITE_SITE_SUPPORT_EMAIL=support@economy-stays.com
VITE_TRACKING_BRAND=economy_stays
VITE_LANDING_ID_PREFIX=ES2-

# Analytics â€” IMPORTANT: each site needs its own ad account IDs.
# Do NOT copy IDs from another site â€” leave blank here and set per-deployment.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
# Google Ads conversion tracking (fires on partner click-out) â€” set per-site
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Offline landing-page generation (scripts only â€” never exposed to browser)
# OPENAI_API_KEY=sk-...

# Alternate brands: proxy edge + skip shared DB tracking. Economy Stays keeps this false.
VITE_USE_API_PROXY=false
# Production: browser calls /api/edge/* (Vercel) instead of embedding Supabase keys.
# Recommended: keep true for all deployments.
VITE_USE_EDGE_PROXY=true
# Local edge functions during `npm run dev` (hotel-affiliate-router + kayak-autocomplete at /api/edge/*).
# Set to false to call remote Supabase functions from the browser instead.
VITE_LOCAL_EDGE=true
VITE_ENABLE_DB_TRACKING=true

# Server-only for Vercel /api/edge (runtime). Prefer these over VITE_* for the API route.
# SUPABASE_ANON_KEY=your-anon-key

# Booking.com via CJ (Commission Junction) â€” primary monetization
VITE_CJ_CLICK_DOMAIN=kqzyfj.com
VITE_CJ_PID=your-cj-pid
VITE_CJ_AID=your-cj-aid
# Server-only aliases
CJ_CLICK_DOMAIN=kqzyfj.com
CJ_PID=your-cj-pid
CJ_AID=your-cj-aid
BOOKING_AFFILIATE_PROVIDER=cj

# Kayak — primary monetization (affiliate ID: kan_317689_594114)
VITE_KAYAK_AFFILIATE_ID=kan_317689_594114
VITE_KAYAK_DEEPLINK_BASE=https://www.kayak.com/in
