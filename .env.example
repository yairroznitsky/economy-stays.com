# Supabase (client may still use anon for edge invoke when not proxied)
VITE_SUPABASE_URL=https://vbtmydsmqlkzfmbcmfxb.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only tracking (POST /api/landings, /api/search → service role inserts)
SUPABASE_URL=https://vbtmydsmqlkzfmbcmfxb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: point browser at api.cheap-stays.com (bare /landings + /search via vercel rewrites)
# VITE_TRACKING_API_BASE=https://api.cheap-stays.com

# Site identity (defaults match Cheap Stays)
VITE_SITE_NAME=Cheap Stays
VITE_SITE_WORDMARK=Cheap-Stays
VITE_SITE_SLUG=cheap-stays
VITE_SITE_SHORT_NAME=CheapStays
# Feed URLs always use www (see scripts/lib/feedSiteDomain.ts).
VITE_SITE_DOMAIN=cheap-stays.com
VITE_SITE_OPERATOR=Media Smarter
VITE_SITE_SUPPORT_EMAIL=support@cheap-stays.com
VITE_TRACKING_BRAND=cheap_stays
VITE_LANDING_ID_PREFIX=CS-

# Analytics (leave blank on alternate deployments to disable pixels)
VITE_META_PIXEL_ID=1335463801463340
VITE_TIKTOK_PIXEL_ID=D8F8KUBC77UANKFS86CG
# Google Ads conversion tracking (fires on partner click-out)
VITE_GOOGLE_ADS_ID=AW-18379518383
VITE_GOOGLE_ADS_CONVERSION_LABEL=m0FMCIz20d4cEK_jhLxE

# Offline landing-page generation (scripts only — never exposed to browser)
# OPENAI_API_KEY=sk-...

# Alternate brands: proxy edge + skip shared DB tracking. Cheap Stays keeps this false.
VITE_USE_API_PROXY=false
# Production: browser calls /api/edge/* (Vercel) instead of embedding Supabase keys.
# Default is on for production builds; set false to use direct supabase.functions.invoke.
# VITE_USE_EDGE_PROXY=true
# Local edge functions during `npm run dev` (hotel-affiliate-router + kayak-autocomplete at /api/edge/*).
# Set to false to call remote Supabase functions from the browser instead.
VITE_LOCAL_EDGE=true
VITE_ENABLE_DB_TRACKING=true

# Server-only for Vercel /api/edge (runtime). Prefer these over VITE_* for the API route.
# SUPABASE_ANON_KEY=your-anon-key

# Kayak affiliate (client-side deeplinks; also used by local edge for skyscanner mode)
VITE_KAYAK_AFFILIATE_ID=kan_317716_594040
VITE_KAYAK_DEEPLINK_BASE=https://www.kayak.com/in
VITE_KAYAK_UTM_MEDIUM=affiliate
# Server-only aliases for local edge / Supabase hotel-affiliate-router
KAYAK_AFFILIATE_ID=kan_317716_594040
KAYAK_DEEPLINK_BASE=https://www.kayak.com/in
KAYAK_UTM_MEDIUM=affiliate
