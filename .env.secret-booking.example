# Alternate deployment example (e.g. secret-booking.com)
#
# Copy to .env.secret-booking and build with: vite build --mode secret-booking
# Same Supabase project — credentials stay server-side only (Vercel env vars).

# Do NOT set VITE_SUPABASE_URL or VITE_SUPABASE_ANON_KEY on this deployment.
VITE_USE_API_PROXY=true

VITE_SITE_NAME=Secret Booking
VITE_SITE_WORDMARK=Secret-Booking
VITE_SITE_SLUG=secret-booking
VITE_SITE_SHORT_NAME=SecretBooking
VITE_SITE_DOMAIN=secret-booking.com
VITE_SITE_OPERATOR=Your Operator Name
VITE_TRACKING_BRAND=secret_booking
VITE_LANDING_ID_PREFIX=SB-

# Disable shared pixels unless you create separate ad accounts/pixels
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Server-only (Vercel dashboard / local .env.secret-booking — never VITE_ prefix):
# SUPABASE_URL=https://vbtmydsmqlkzfmbcmfxb.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
#
# Supabase Edge Function secrets (same project):
# SITE_SLUG=secret-booking
# SKYSCANNER_UTM_SOURCE=secret-booking
# BOT_NAME=SecretBookingBot
# SITE_DOMAIN=secret-booking.com
